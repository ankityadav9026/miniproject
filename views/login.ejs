<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-950 via-indigo-950 to-purple-950 p-4">

  <div class="w-full max-w-sm bg-white/10 backdrop-blur-xl border border-white/20 p-8 rounded-3xl shadow-2xl">

    <div class="text-center mb-7">
      <div class="text-5xl mb-3">🔐</div>
      <h1 class="text-3xl font-bold text-white">Welcome Back!</h1>
      <p class="text-gray-400 text-sm mt-2">Login to your account</p>
    </div>

    <a href="/index" class="block text-center text-indigo-300 hover:text-white mb-5 text-sm">
      ← Create a new account
    </a>

    <a href="/profile" class="block text-center bg-white/10 hover:bg-white/20 text-white rounded-lg py-2 mb-5 transition">
      View Profile
    </a>

    <form action="/login" method="POST" class="space-y-4">

      <input
        class="w-full p-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-gray-400 outline-none focus:border-indigo-400"
        type="email" name="email" placeholder="Email address" required>

      <input
        class="w-full p-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-gray-400 outline-none focus:border-indigo-400"
        type="password" name="password" placeholder="Password" required>

      <button
        type="submit"
        class="w-full py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-500 hover:to-purple-500 text-white font-bold transition shadow-lg">
        Login →
      </button>

    </form>

    <p class="text-center text-gray-500 text-xs mt-6">
      Secure Login · Welcome Back ✨
    </p>

  </div>

</body>
</html>