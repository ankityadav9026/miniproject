<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>                                       
    <div class="w-full min-h-screen bg-zinc-900 p-4  text-white ">
    <div class="flex flex-w justify-end">
    <a class="bg-red-600 px-3 py-2 w-25 rounded-xl h-full inline-block mb-5" href="/logout">Logout</a>
     </div>
    <h5 class="text-2xl ">your Profile</h5>
    <h5 class="text-2xl ">Hello </h5>
    <form action="/post" method="post">
    <textarea class="resize-none bg-transparent border-2 border-zinc-700 rounded-md" placeholder="what,s on your mind" name ="content" ></textarea>
    <button class="bg-blue-600 p-3    block rounded-xl">create new post</button>
     </form>
     <div class="posts mt-20"  >
        <h3 class="text-zinc-400">your posts.</h3>
        <div class="postcontainer mt-5 flex flex-col gap-5">
            
            

          <% user.posts.reverse().forEach(function(post){ %>
            <div class="post w-full   max-w-xl p-4 rounded-xl  bg-zinc-600 border-zinc-700">
                <h4 class="text-blue-600"><%= user.username %></h4>
                    <p><%= post.content %></p>
                 
                 <div class=" flex flex-w gap-4">
                 <small>Likes<%= post.likes.length+10000 %></small>
                    <a class="text-red-600" href="/like/<%= post._id%>"><%= post.likes.indexOf(user._id)==-1? "Like": "Unlike"   %></a>
                    <a class="text-blue-600" href="/edit/<%= post._id%>">Edit</a>
                </div>
            </div>
         <% }) %>



         </div>

     </div>
      
</body>
</html>  


