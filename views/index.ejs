<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-950 to-indigo-950 p-4">

  <div class="w-full max-w-sm bg-white/10 border border-white/20 p-7 rounded-2xl shadow-2xl">
    <h2 class="text-3xl font-bold text-white text-center mb-2">Create Account</h2>
    <p class="text-gray-400 text-center mb-6">Register to get started ✨</p>

    <form action="/register" method="post" class="flex flex-col gap-4">

      <input class="w-full p-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 outline-none focus:border-indigo-400" type="text" placeholder="Name" name="name" required>

      <input class="w-full p-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 outline-none focus:border-indigo-400" type="text" placeholder="Username" name="username" required>

      <input class="w-full p-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 outline-none focus:border-indigo-400" type="password" placeholder="Password" name="password" required>

      <input class="w-full p-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 outline-none focus:border-indigo-400" type="email" placeholder="Email" name="email" required>

      <input class="w-full p-3 rounded-lg bg-white/10 border border-white/20 text-white placeholder-gray-400 outline-none focus:border-indigo-400" type="number" placeholder="Age" name="age" required>

      <button type="submit" class="bg-indigo-600 hover:bg-purple-600 text-white font-bold p-3 rounded-lg transition">
        Create Account →
      </button>
    </form>

    <p class="text-gray-400 text-sm text-center mt-5">
      Already registered?
      <a href="/login" class="text-indigo-400 hover:text-purple-400">Login</a>
    </p>
  </div>

</body>
</html>